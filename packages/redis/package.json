{
	"name": "@gramio/storage-redis",
	"version": "1.0.5",
	"description": "Redis Storage for GramIO",
	"main": "./dist/ioredis.cjs",
	"module": "./dist/ioredis.js",
	"types": "./dist/ioredis.d.ts",
	"exports": {
		".": {
			"bun": {
				"types": "./dist/bun.d.ts",
				"default": "./dist/bun.js"
			},
			"import": {
				"types": "./dist/ioredis.d.ts",
				"default": "./dist/ioredis.js"
			},
			"require": {
				"types": "./dist/ioredis.d.cts",
				"default": "./dist/ioredis.cjs"
			}
		},
		"./ioredis": {
			"import": {
				"types": "./dist/ioredis.d.ts",
				"default": "./dist/ioredis.js"
			},
			"require": {
				"types": "./dist/ioredis.d.cts",
				"default": "./dist/ioredis.cjs"
			}
		},
		"./bun": {
			"types": "./dist/bun.d.ts",
			"default": "./dist/bun.js"
		}
	},
	"type": "module",
	"homepage": "https://github.com/gramiojs/storages",
	"readme": "https://gramio.dev/storages",
	"scripts": {
		"prepublishOnly": "bunx tsc && bun test && bunx pkgroll"
	},
	"keywords": ["gramio", "gramio-storage", "storage", "redis", "ioredis"],
	"license": "MIT",
	"devDependencies": {
		"@types/bun": "^1.2.15",
		"ioredis-mock": "^8.13.1",
		"pkgroll": "^2.26.0",
		"typescript": "^5.9.3",
		"ioredis": "^5.9.3"
	},
	"files": ["dist"],
	"dependencies": {
		"@gramio/storage": "^2.0.1"
	},
	"peerDependencies": {
		"ioredis": "^5.6.1"
	},
	"peerDependenciesMeta": {
		"ioredis": {
			"optional": true
		}
	}
}
